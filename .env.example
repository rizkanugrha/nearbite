# ================================================================
# API CONFIGURATION
# ================================================================
# Base URL untuk REST API server
# Kosongkan untuk menggunakan Mock API (fixture offline)
# 
# Contoh:
# API_BASE_URL=https://api.example.com
# API_BASE_URL=http://localhost:8080
API_BASE_URL=

# Bearer token untuk REST API (opsional)
# Hanya digunakan jika API_BASE_URL tidak kosong
# 
# Contoh:
# API_TOKEN=your-secret-token-here
# API_TOKEN=Bearer eyJhbGciOiJIUzI1NiIs...
API_TOKEN=

# ================================================================
# CATATAN PENTING
# ================================================================
# 1. File ini adalah TEMPLATE/CONTOH (.env.example)
#    JANGAN di-commit ke version control
#
# 2. Untuk development lokal:
#    - Buat file .env di root project
#    - Copy isi dari .env.example
#    - Isi dengan nilai yang sesuai untuk environment Anda
#
# 3. File .env sudah di-add ke .gitignore
#    (jangan di-commit ke git!)
#
# 4. Cara menjalankan dengan API_BASE_URL:
#    flutter run \
#      --dart-define=API_BASE_URL=https://your-server.com \
#      --dart-define=API_TOKEN=your-token
#
# 5. Jika API_BASE_URL kosong, aplikasi otomatis gunakan Mock API
#    (fixture offline) sehingga tetap bisa dijalankan tanpa server
